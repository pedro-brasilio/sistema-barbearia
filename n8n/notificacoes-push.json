          }
        ]
      ]
    },
    "Um item por celular": {
      "main": [
        [
          {
            "node": "Envia pelo Firebase (FCM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envia pelo Firebase (FCM)": {
      "main": [
        [
          {
            "node": "Conta os envios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conta os envios": {
      "main": [
        [
          {
            "node": "Responde para a API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
